<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#000000">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    
    <title>IPTV OSCORP</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    
    <style>
        :root {
            --bg-deep: #000000;
            --main-color: #FFD700; /* Tom GOLD */
            --badge-bg: #00a8ff; 
            --font-xs: 1.8vh; --font-sm: 2.2vh; --font-md: 3vh; --font-lg: 5vh;
        }

        * { 
            margin: 0; padding: 0; box-sizing: border-box; outline: none; 
            -webkit-tap-highlight-color: transparent; -webkit-user-select: none; user-select: none;           
        }
        
        html, body {
            background: #000000; color: #ffffff; font-family: 'Montserrat', sans-serif;
            position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; 
            overflow: hidden !important; overscroll-behavior: none; touch-action: none;
            transform: translate3d(0,0,0); -webkit-transform: translate3d(0,0,0);
            backface-visibility: hidden; -webkit-backface-visibility: hidden;
        }

        /* ----- SPLASH SCREEN LIMPA ----- */
        #splash-screen {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #000000; z-index: 9999999;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }
        .splash-logo {
            font-size: 15vh; font-weight: 900; letter-spacing: 2px;
            animation: splashPulse 1.5s infinite ease-in-out;
        }
        
        @keyframes splashPulse {
            0% { transform: scale(0.9); opacity: 0.7; }
            50% { transform: scale(1.1); opacity: 1; text-shadow: 0 0 20px rgba(255, 215, 0, 0.4); }
            100% { transform: scale(0.9); opacity: 0.7; }
        }

        .hide { display: none !important; }
        .flex-center { display: flex; align-items: center; justify-content: center; }
        .layer { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 10; background: transparent; overflow: hidden; }

        #orientation-overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #000; z-index: 99999; flex-direction: column; align-items: center; justify-content: center;
            color: var(--main-color); text-align: center; font-weight: 900; font-size: 3vh;
        }
        .phone-icon { width: 10vh; height: 10vh; margin-bottom: 20px; animation: rotatePhone 2s infinite ease-in-out; }
        @keyframes rotatePhone { 0%, 100% { transform: rotate(0deg); opacity: 0; } 25%, 50% { transform: rotate(-90deg); opacity: 1; } 75% { transform: rotate(-90deg); opacity: 0; } }
        @media screen and (max-width: 768px) and (orientation: portrait) { #orientation-overlay { display: flex !important; } }

        button, .smart-card, .cat-item, .item, .power-btn, .key, .toggle-btn { cursor: pointer; }
        
        .focused { 
            border: 3px solid #fff !important; background: var(--main-color) !important; color: #000 !important; 
            z-index: 50; box-shadow: none !important; transform: scale(1.02) translateZ(0) !important;
            transition: transform 0.1s ease-out, background 0.1s;
        }
        .focused svg, .focused span, .focused div { color: #000 !important; fill: #000 !important; }
        
        #vid-box.focused { border: 4px solid var(--main-color) !important; background: transparent !important; transform: none !important; }
        #vid-box.fs, #vid-box.fs.focused { border: none !important; width: 100% !important; height: 100% !important; z-index: 9999 !important; position: absolute !important; top: 0 !important; left: 0 !important; background: #000 !important; transform: none !important; }

        .login-box { width: 450px; max-width: 90%; padding: 40px; background: #0a0a0a; border: 2px solid var(--main-color); border-radius: 12px; text-align: center; }
        .logo-txt { font-size: 4.5vh; font-weight: 900; margin-bottom: 2.5vh; display: flex; align-items: center; justify-content: center; gap: 10px; }
        .theme-text { color: var(--main-color); }
        .inp { width: 100%; padding: 16px; margin: 10px 0; background: #1a1a1a; border: 1px solid #333; color: #fff; text-align: center; font-weight: 600; border-radius: 8px; font-size: 16px; }
        .btn { width: 100%; padding: 16px; margin-top: 20px; background: var(--main-color); color: #000; border: none; font-weight: 900; border-radius: 8px; font-size: 16px; }
        .btn-logout { background: #333; color: #fff; margin-top: 10px; border: 1px solid #444; }

        .config-row { display: flex; gap: 1vw; margin: 2vh 0; }
        .toggle-btn { flex: 1; padding: 1.5vh; background: #1a1a1a; border: 1px solid #333; color: #888; font-size: var(--font-sm); font-weight: 800; border-radius: 1vh; }
        .info-row { display: flex; justify-content: space-between; padding: 1vh 0; border-bottom: 1px solid #222; font-size: var(--font-sm); color: #ccc; }
        
        #dash-layer { display: flex; flex-direction: column; padding: 4vh 4vw; height: 100%; overflow: hidden; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; height: 14vh; margin-bottom: 2vh; flex-shrink: 0; }
        .dash-logo { font-size: var(--font-lg); font-weight: 900; }
        .dash-clock { text-align: right; }
        .clock-time { font-size: 6vh; font-weight: 700; color: #eee; line-height: 1; }
        .clock-date { font-size: 2.5vh; color: #ccc; font-weight: 600; margin-top: 0.8vh; }
        
        @keyframes pulse-btn {
            0% { transform: scale(1); outline: 0px solid rgba(255, 215, 0, 0.4); }
            50% { transform: scale(1.15); outline: 5px solid rgba(255, 215, 0, 0.8); }
            100% { transform: scale(1); outline: 0px solid rgba(255, 215, 0, 0); }
        }
        .top-actions { display: flex; gap: 2vh; }
        .power-btn { width: 7vh; height: 7vh; background: transparent; border: none; color: #666; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; border-radius: 50%; }
        .power-btn.focused { animation: pulse-btn 1.2s infinite; background: var(--main-color) !important; color: #000 !important; }
        .power-btn svg { width: 4vh; height: 4vh; fill: currentColor; }

        .dash-grid { display: flex; gap: 4vw; justify-content: center; align-items: center; flex: 1; width: 100%; }
        .smart-card { width: 24vw; height: 50vh; background: #101010; border: 1px solid #333; border-radius: 2.5vh; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .smart-card svg { width: 15vh; height: 15vh; margin-bottom: 4vh; fill: #444; }
        .smart-card span { font-size: 3.5vh; font-weight: 900; color: #fff; text-transform: uppercase; }
        .bottom-bar { display: flex; justify-content: space-between; margin-top: auto; padding-bottom: 1vh; flex-shrink: 0; }
        .info-pill { background: #111; padding: 1.5vh 2.5vw; border-radius: 50px; border: 1px solid #222; }
        .lbl { font-size: var(--font-xs); color: #999; display: block; font-weight: 700; }
        .val { font-size: var(--font-md); color: var(--main-color); font-weight: 900; }

        /* SISTEMA DE LAYOUT DINÂMICO */
        #content-layer { display: flex; width: 100%; height: 100%; background: #000; overflow: hidden; }
        .col-cat { width: 25%; background: #08080a; display: flex; flex-direction: column; border-right: 2px solid #1a1a1a; height: 100%; overflow: hidden; flex-shrink: 0; transition: width 0.3s; }
        .col-list { width: 35%; background: #101014; display: flex; flex-direction: column; border-right: 2px solid #1a1a1a; height: 100%; overflow: hidden; transition: width 0.3s; }
        .col-play { flex: 1; display: flex; flex-direction: column; position: relative; background: #000; height: 100%; overflow: hidden; }

        /* MODO LISTA TEXTO */
        .layout-list .col-cat { width: 25%; }
        .layout-list .col-list { width: 35%; border-right: 2px solid #1a1a1a; }
        .layout-list .col-play { display: flex; }
        .layout-list .item-list { display: block; padding: 0; }

        /* MODO GRID CARTÕES */
        .layout-grid .col-cat { width: 20%; }
        .layout-grid .col-list { flex: 1; width: auto; border-right: none; }
        .layout-grid .col-play { display: none; }
        
        .layout-grid .item-list { display: block; padding: 1.5vw; overflow-y: auto; }
        .layout-grid .item-list::after { content: ""; display: table; clear: both; }

        /* Sistema de FULLSCREEN para Grid */
        #content-layer.fullscreen-mode .col-cat,
        #content-layer.fullscreen-mode .col-list { display: none !important; }
        #content-layer.fullscreen-mode .col-play { display: flex !important; position: fixed !important; top: 0; left: 0; width: 100%; height: 100%; z-index: 99999; }
        #content-layer.fullscreen-mode .meta { display: none !important; }

        .cat-head { padding: 15px; background: #15151a; color: var(--main-color); border-bottom: 2px solid #222; text-align: center; font-size: var(--font-md); font-weight: 900; flex-shrink: 0; }
        .cat-top-row { display: flex; align-items: center; width: 100%; }
        .btn-voltar { width: 4vh; height: 4vh; border-radius: 50%; border: 2px solid var(--main-color); display: flex; align-items: center; justify-content: center; font-size: var(--font-sm); margin-right: 1vw; color: var(--main-color); }
        .btn-voltar svg { width: 2vh; height: 2vh; fill: currentColor; }
        
        /* OTIMIZAÇÃO: Aceleração de Hardware para rolagem suave */
        .cat-list, .item-list { flex: 1; height: 100%; overflow-y: auto; -webkit-overflow-scrolling: touch; will-change: transform, scroll-position; transform: translateZ(0); touch-action: pan-y; }
        
        .cat-item, .item { border-radius: 6px; color: #888; font-size: var(--font-sm); font-weight: 700; border: 1px solid transparent; }
        
        .cat-item { padding: 14px 20px; margin: 6px 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .cat-item.active { background: #1a1a1a; color: #fff; border-left: 4px solid var(--main-color); }
        
        .layout-list .item { padding: 14px 20px; margin: 6px 12px; border-bottom: 1px solid #1a1a1a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; }
        .layout-list .item.playing { color: var(--main-color) !important; background: #111 !important; border-left: 4px solid var(--main-color); }
        .fav-icon { fill: var(--main-color); margin-left: auto; width: 2.5vh; height: 2.5vh; }
        .live-num { width: 40px; color: #666; font-size: 0.85em; font-weight: 900; flex-shrink: 0; }
        
        /* Grid de Cartões - 6 POR LINHA */
        .poster-card {
            float: left; width: 15%; margin: 0.83%; height: 32vh; 
            background: #151515; position: relative; 
            padding: 0 !important; border: none !important; outline: 3px solid transparent;
            transition: transform 0.2s ease, outline-color 0.2s ease;
            box-sizing: border-box;
        }
        
        /* OTIMIZAÇÃO GPU: Substituído border e box-shadow por outline seco */
        .layout-grid .item.poster-card.focused {
            outline: 4px solid var(--main-color) !important; 
            transform: scale(1.08) translateZ(0) !important;
            z-index: 10;
        }

        .layout-grid .item.poster-card.focused .poster-title-bg { background: var(--main-color) !important; height: auto; max-height: 100%; }
        .layout-grid .item.poster-card.focused .poster-title { color: #000 !important; white-space: normal; overflow: visible; line-height: 1.2; }
        
        .poster-img { width: 100%; height: 100%; object-fit: fill; position: absolute; top: 0; left: 0; }
        
        .poster-badge {
            position: absolute; top: 8px; left: 8px; background: var(--badge-bg); color: white;
            font-size: 1.4vh; font-weight: 900; padding: 3px 8px; border-radius: 4px;
            z-index: 2; box-shadow: 0 2px 5px rgba(0,0,0,0.5);
        }
        .poster-title-bg { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.85); padding: 1.2vh; text-align: center; z-index: 2; transition: background 0.2s ease; }
        
        .poster-title { color: #fff; font-size: 1.6vh; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; transition: color 0.2s ease; }

        .search-area { padding: 15px; background: #050505; border-bottom: 2px solid #1a1a1a; flex-shrink: 0; }
        .inp-search { width: 100%; padding: 12px; background: #111; border: 1px solid #333; color: #fff; font-size: var(--font-sm); font-weight: bold; border-radius: 6px; text-transform: uppercase; text-align: center; }

        .vid-box { 
            width: 100%; height: 50vh; background: #000; position: relative; border-bottom: 2px solid #222; overflow: hidden; flex-shrink: 0;
            touch-action: manipulation; transform: translateZ(0); 
        }
        
        #player-container { width:100%; height:100%; background:#000; transform: translateZ(0); }
        video { width: 100%; height: 100%; object-fit: fill; background: #000; z-index: 1; transform: translateZ(0); }

        .buffer-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 50; display: none; flex-direction: column; align-items: center; justify-content: center; }
        
        /* Bolinha de Loading Estilo WAREZ */
        .buffer-spinner { width: 8vh; height: 8vh; animation: spin 1s linear infinite; }
        @keyframes spin { 100% { transform: rotate(360deg); } }

        .meta { padding: 25px; flex: 1; height: 100%; overflow-y: auto; background: #0a0a0c; display: flex; flex-direction: column; }
        .meta-title { font-size: var(--font-lg); color: var(--main-color); font-weight: 900; margin-bottom: 1vh; }
        .meta-desc { font-size: var(--font-sm); color: #999; margin-bottom: 1vh; }
        
        .keys { display: flex; justify-content: space-between; align-items: center; gap: 1vw; padding-top: 2vh; border-top: 2px solid #1a1a1a; margin-top: auto; flex-shrink: 0; }
        .key { flex: 1; font-size: var(--font-xs); color: #fff; font-weight: 700; background: #1a1a1a; border: 1px solid #333; padding: 1.2vh 0.5vw; border-radius: 0.8vh; display: flex; align-items: center; justify-content: center; white-space: nowrap; }
        .dot { width: 1.2vh; height: 1.2vh; border-radius: 50%; flex-shrink: 0; margin-right: 1.2vw; }

        #pause-layer { display: none; position: absolute; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.5); z-index: 9000; align-items: center; justify-content: center; pointer-events: none; }
        #pause-layer svg { width: 10vh; height: 10vh; fill: rgba(255, 255, 255, 0.9); filter: drop-shadow(0 0 20px #000); }
        
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: #444; border-radius: 10px; }
    </style>
</head>
<body onload="App.init()">

    <div id="splash-screen">
        <div class="splash-logo"><span style="color:#fff">IPTV</span> <span class="theme-text">OSCORP</span></div>
    </div>

    <div id="orientation-overlay">
        <svg class="phone-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"></path></svg>
        <div>POR FAVOR<br><span style="color: var(--main-color);">GIRE A TELA</span></div>
    </div>

    <div id="login-layer" class="layer flex-center hide">
        <div class="login-box">
            <div class="logo-txt"><span style="color:#fff">IPTV</span> <span class="theme-text">OSCORP</span></div>
            <input type="text" id="i0" class="inp focusable" placeholder="URL DNS" autocomplete="off">
            <input type="text" id="i1" class="inp focusable" placeholder="USUÁRIO" autocomplete="off">
            <input type="password" id="i2" class="inp focusable" placeholder="SENHA" autocomplete="off">
            <button id="i3" class="btn focusable" onclick="App.login(false)">ENTRAR AGORA</button>
            <div id="msg-login" style="color:var(--main-color); margin-top:20px; font-size:var(--font-sm); font-weight: 800;"></div>
        </div>
    </div>

    <div id="settings-layer" class="layer hide flex-center">
        <div class="login-box">
            <div class="logo-txt" id="set-title-txt">
                <svg viewBox="0 0 24 24" width="3vh" height="3vh" fill="var(--main-color)" style="margin-right:10px;"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"></path></svg>
                MINHA <span class="theme-text" style="margin-left:8px;">CONTA</span>
            </div>
            <div class="info-row"><span id="lbl-set-u">USUÁRIO:</span> <span id="set-user">...</span></div>
            <div class="info-row"><span id="lbl-set-d">CRIADO:</span> <span id="set-created">...</span></div>
            <div class="info-row"><span id="lbl-set-e">VENCIMENTO:</span> <span id="set-exp">...</span></div>
            <div class="info-row"><span id="lbl-set-c">TELAS:</span> <span id="set-conn">...</span></div>
            
            <div class="config-row" style="margin-top: 30px;"><div id="s0" class="toggle-btn focusable" style="border-color: #333; background: #111; cursor: default;">OPÇÕES</div></div>
            <div class="config-row">
                <div id="s1" class="toggle-btn focusable" onclick="App.toggleCfg('filter')"><span id="lbl-set-filter">XXX:</span> <span id="lbl-filter" style="color:#fff">NÃO</span></div>
                <div id="s2" class="toggle-btn focusable" onclick="App.toggleFormat()"><span id="lbl-set-format">FMT:</span> <span id="lbl-format" style="color:#fff">TS NAT</span></div>
            </div>
            
            <button id="s3" class="btn focusable" onclick="App.closeSettings()" style="background: #333; color: #fff; margin-top: 20px;">VOLTAR</button>
            <button id="s4" class="btn btn-logout focusable" onclick="App.logout()">SAIR / DESLOGAR</button>
        </div>
    </div>

    <div id="dash-layer" class="layer hide">
        <div class="top-bar">
            <div class="dash-logo"><span style="color:#fff">IPTV</span>&nbsp;<span class="theme-text">OSCORP</span></div>
            <div class="dash-clock"><div id="clock-time" class="clock-time">--:--</div><div id="clock-date" class="clock-date">--/--/----</div></div>
            <div class="top-actions">
                <div id="m3" class="power-btn focusable" onclick="App.logout()">
                    <svg viewBox="0 0 24 24"><path d="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z"></path></svg>
                </div>
            </div>
        </div>
        <div class="dash-grid">
            <div id="m0" class="smart-card focusable" role="button" tabindex="-1" onclick="App.openMode('live')">
                <svg viewBox="0 0 24 24"><path d="M21 6h-7.59l3.29-3.29L16 2l-4 4-4-4-.71.71L10.59 6H3c-1.1 0-2 .89-2 2v12c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.11-.9-2-2-2zm0 14H3V8h18v12zM9 10v8l7-4z"></path></svg>
                <span id="dash-m0">TV AO VIVO</span>
            </div>
            <div id="m1" class="smart-card focusable" role="button" tabindex="-1" onclick="App.openMode('movie')">
                <svg viewBox="0 0 24 24"><path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"></path></svg>
                <span id="dash-m1">FILMES</span>
            </div>
            <div id="m2" class="smart-card focusable" role="button" tabindex="-1" onclick="App.openMode('series')">
                <svg viewBox="0 0 24 24"><path d="M19 9H2v2h17V9zm0-4H2v2h17V5zM2 15h13v-2H2v2zm15-2v6l5-3-5-3z"></path></svg>
                <span id="dash-m2">SÉRIES</span>
            </div>
        </div>
        <div class="bottom-bar">
            <div class="info-pill"><span class="lbl" id="lbl-exp-txt">VENCIMENTO</span><span id="info-exp" class="val">...</span></div>
            <div class="info-pill" style="text-align: right;"><span class="lbl" id="lbl-conn-txt">CONEXÕES</span><span id="info-conn" class="val">...</span></div>
        </div>
    </div>

    <div id="content-layer" class="layer hide layout-list">
        <div class="col-cat">
            <div class="cat-head">
                <div class="cat-top-row">
                    <div id="btn-back" class="btn-voltar hide" onclick="App.back()">
                        <svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"></path></svg>
                    </div>
                    <div id="cat-title-txt" style="flex:1;">MENU</div>
                </div>
                <div id="item-count" style="font-size: 0.7em; margin-top: 5px; opacity: 0.7;">TOTAL: ...</div>
            </div>
            <div id="cat-list" class="cat-list"></div>
        </div>
        
        <div class="col-list">
            <div class="search-area"><input type="text" id="search" class="inp-search focusable" placeholder="BUSCAR..." autocomplete="off"></div>
            <div id="item-list" class="item-list"></div>
        </div>
        
        <div class="col-play">
            <div id="vid-box" class="vid-box focusable" onclick="App.handleVideoTap(event)">
                <div id="player-container">
                    <video id="player" playsinline webkit-playsinline preload="auto" disablePictureInPicture></video>
                </div>
                
                <div id="smart-buffer" class="buffer-overlay">
                    <svg class="buffer-spinner" viewBox="0 0 24 24" fill="none" stroke="var(--main-color)" stroke-width="3" stroke-linecap="round"><path d="M12 2a10 10 0 1 0 10 10"></path></svg>
                </div>

                <div id="pause-layer">
                    <svg viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path></svg>
                </div>
            </div>
            
            <div class="meta">
                <div id="meta-title" class="meta-title"><span style="color:#fff">IPTV</span>&nbsp;OSCORP</div>
                <div id="meta-desc" class="meta-desc"></div>
                
                <div class="keys">
